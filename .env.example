# Copy these into your hosting dashboard (or export them in your shell). Never commit a real key.
ANTHROPIC_API_KEY=your-key-here

# Optional
# CHAT_MODEL=claude-haiku-5-5        # fast model for the live conversation
# ANALYSIS_MODEL=claude-sonnet-5-5   # model for the end-of-call summary and status
# RATE_LIMIT_PER_10_MIN=150          # requests per visitor IP per 10 minutes
# PORT=3000
